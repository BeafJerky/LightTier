{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.lighttier.app",
  // 平台配置按 JSON Merge Patch 合并：数组会整体替换而非逐项合并。
  // 这里不能出现 app.windows，否则会覆盖基础配置的窗口数组（丢失 title/尺寸/visible 等），
  // 窗口标题会回退为 Tauri 默认的 "Tauri App"。
  "bundle": {
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        // bundle.icon 只作用于应用 exe；安装器图标需单独指定，否则回退 NSIS 默认图标
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        // 勾选“删除应用数据”时同时清理安装目录下的运行期数据（config/logs/resource）
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
