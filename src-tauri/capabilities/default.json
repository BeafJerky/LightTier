{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:window:allow-set-skip-taskbar",
    "window-state:default",
    "fs:default",
    "fs:read-files",
    "fs:write-files",
    "fs:scope-log",
    "fs:allow-exists",
    "fs:allow-open",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-resource-read",
    "fs:allow-resource-read-recursive",
    "fs:allow-resource-write",
    "fs:allow-resource-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-app-read-recursive",
    "log:default",
    "log:allow-log",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "os:default",
    "os:allow-hostname",
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-remove-by-id",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-icon-as-template",
    "core:tray:allow-set-menu",
    "core:tray:allow-set-show-menu-on-left-click",
    "core:tray:allow-set-title",
    "core:tray:allow-set-tooltip",
    "core:tray:allow-set-visible",
    "core:window:allow-unminimize",
    "core:window:allow-is-minimized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:app:allow-default-window-icon",
    "core:path:allow-is-absolute",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-open",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "cmd": "$RESOURCE/resource/nssm",
          "name": "nssm"
        },
        {
          "args": true,
          "cmd": "$RESOURCE/resource/core/easytier-core",
          "name": "easytier-core"
        },
        {
          "args": true,
          "cmd": "$RESOURCE/resource/core/easytier-cli",
          "name": "easytier-cli"
        },
        {
          "args": true,
          "cmd": "powershell",
          "name": "powershell"
        },
        {
          "args": true,
          "cmd": "taskkill",
          "name": "taskkill"
        },
        {
          "args": true,
          "cmd": "kill",
          "name": "kill"
        },
        {
          "args": true,
          "cmd": "route",
          "name": "route"
        },
        {
          "args": true,
          "cmd": "sh",
          "name": "sh"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
