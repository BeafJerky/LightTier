{
  // 指定 schema 文件路径，用于验证配置文件格式
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  // 应用程序名称
  "productName": "LightTier",
  // 应用程序版本号
  "version": "1.9.1",
  // 应用程序唯一标识符
  "identifier": "com.lighttier.app",
  // 构建相关配置
  "build": {
    // 前端构建输出目录
    "frontendDist": "../dist",
    // 开发服务器 URL
    "devUrl": "http://localhost:4000",
    // 开发命令执行前的命令
    "beforeDevCommand": "pnpm dev",
    // 构建命令执行前的命令
    "beforeBuildCommand": "pnpm build"
  },
  // 应用程序配置
  "app": {
    // 窗口配置
    "windows": [
      {
        // 窗口标题
        "title": "LightTier",
        // 窗口宽度（像素）
        "width": 1000,
        // 窗口高度（像素）
        "height": 650,
        // 最小窗口尺寸：低于此值详情头部/工具栏无法完整承载
        "minWidth": 900,
        "minHeight": 600,
        // 是否可调整大小
        "resizable": true,
        // 是否全屏显示
        "fullscreen": false,
        // 是否居中显示
        "center": true,
        // 是否可见（设置为 false 可避免白屏，等前端加载完再显示）
        "visible": false,
        // 是否显示窗口装饰（如标题栏、边框等）
        "decorations": false,
        // 是否透明
        "transparent": false,
        // 是否启用开发者工具
        "devtools": false
      }
    ],
    // 安全相关配置
    "security": {
      // 内容安全策略（CSP）：禁止内联/远程脚本；样式需 unsafe-inline（Vue 动态样式）；
      // 放行 Google Fonts、Tauri IPC/asset 协议、镜像测速主机（connect-src https:）与开发服务器 HMR
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost http://localhost:4000 ws://localhost:4000 https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    },
    // 不注入 window.__TAURI__ 全局对象（应用内统一经 @tauri-apps/api 的 isTauri() 检测）
    "withGlobalTauri": false
  },
  // 打包配置
  "bundle": {
    // 是否启用打包
    "active": true,
    // 打包目标平台
    "targets": "all",
    // 应用程序类别
    "category": "DeveloperTool",
    // 应用程序简短描述
    "shortDescription": "LightTier",
    // 应用程序详细描述
    "longDescription": "LightTier",
    // 应用程序图标
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    // 应用程序资源文件
    // 注意：Tauri 的 glob 不会递归展开被匹配到的目录，必须逐个列出子目录内容；
    // 只写 resource/* 会导致 themes/ 未进入安装包（外部主题失效）。
    // 内核安装包不再随桌面安装包内置：resource/core 由应用在运行时按需下载/安装。
    "resources": [
      "resource/*",
      "resource/themes/*"
    ]
  },
  // 插件配置
  "plugins": {
    // Shell 插件配置
    "shell": {
      // 允许打开的 URL 模式
      "open": "*"
    }
  }
}