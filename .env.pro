# 环境
VITE_NODE_ENV=production

# 打包路径
VITE_BASE_PATH=./

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 输出路径
VITE_OUT_DIR=dist

# 标题
VITE_APP_TITLE="LightTier"

# 是否包分析
VITE_USE_BUNDLE_ANALYZER=false

# 是否切割css
VITE_USE_CSS_SPLIT=true
