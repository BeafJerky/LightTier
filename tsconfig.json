{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsxImportSource": "vue",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": "./",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    // TODO: remove skipLibCheck after third-party lib types are fixed (vueuse, unplugin, vue-i18n, etc.)
    "skipLibCheck": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["@intlify/unplugin-vue-i18n/types", "vite/client"]
  },
  "include": ["src", "types/**/*.d.ts", "vite.config.ts"]
}
